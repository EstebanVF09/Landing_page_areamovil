---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada — Areamovil" description="Esta página no existe.">
  <section class="relative min-h-screen flex items-center justify-center bg-am-dark overflow-hidden">
    <div class="absolute inset-0 opacity-5 bg-grid pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/3 w-96 h-96 bg-am-accent/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
      <div class="text-[120px] md:text-[180px] font-bold leading-none text-am-accent/20 select-none mb-4">
        404
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Página no encontrada
      </h1>
      <p class="text-gray-400 text-lg mb-10">
        La página que buscas no existe o fue movida.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-am-yellow text-am-dark font-semibold px-8 py-4 rounded-lg hover:bg-am-yellow/90 transition-all duration-300 group"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Volver al Home
      </a>
    </div>
  </section>
</BaseLayout>

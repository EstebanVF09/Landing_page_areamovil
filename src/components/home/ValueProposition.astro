---
const values = [
  {
    title: 'Investigamos para entender',
    description: 'Analizamos comportamientos, necesidades y puntos de fricción para tomar decisiones de diseño mejor fundamentadas.',
    icon: 'search',
  },
  {
    title: 'Diseñamos para dar claridad',
    description: 'Organizamos la información, definimos jerarquías y construimos interfaces fáciles de recorrer y de comprender.',
    icon: 'pen',
  },
  {
    title: 'Sistematizamos para escalar',
    description: 'Creamos componentes, patrones y criterios que permiten mantener consistencia y crecer con mayor eficiencia.',
    icon: 'layers',
  },
];
---

<section class="py-24 bg-am-dark relative overflow-hidden">
  <!-- Background blobs -->
  <div class="absolute top-10 right-20 w-96 h-96 bg-am-accent rounded-full blur-3xl opacity-5 pointer-events-none"></div>
  <div class="absolute bottom-10 left-20 w-96 h-96 bg-am-yellow rounded-full blur-3xl opacity-5 pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">

    <!-- Title -->
    <div class="text-center mb-16 max-w-3xl mx-auto reveal">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Diseño con <span class="text-am-accent">criterio</span>, no solo con estética
      </h2>
      <p class="text-lg text-gray-300 leading-relaxed">
        Nuestro enfoque UX/UI parte de comprender el contexto, identificar oportunidades y traducirlas en
        decisiones de diseño que tengan sentido para el usuario, el producto y el negocio. No diseñamos
        pantallas aisladas: diseñamos experiencias coherentes, intuitivas y preparadas para evolucionar.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {values.map((v, i) => (
        <div class="group relative reveal" data-delay={String(i * 0.2)}>
          <div class="h-full p-8 rounded-2xl border border-white/10 bg-gradient-to-b from-white/5 to-transparent
                      backdrop-blur-sm hover:border-am-accent/50 hover:shadow-lg hover:shadow-am-accent/10 transition-all duration-300">

            <!-- Icon -->
            <div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-am-accent/20 to-am-accent/5
                        border border-am-accent/30 mb-6 group-hover:scale-110 transition-transform duration-300">
              {v.icon === 'search' && (
                <svg class="w-6 h-6 text-am-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
              )}
              {v.icon === 'pen' && (
                <svg class="w-6 h-6 text-am-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>
                </svg>
              )}
              {v.icon === 'layers' && (
                <svg class="w-6 h-6 text-am-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>
                </svg>
              )}
            </div>

            <h3 class="text-xl font-semibold text-white mb-4">{v.title}</h3>
            <p class="text-gray-400 leading-relaxed">{v.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

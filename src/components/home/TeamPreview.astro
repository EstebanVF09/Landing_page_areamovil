---
---
<section class="py-24 bg-gradient-to-b from-am-dark to-am-blue relative overflow-hidden">
  <!-- Pattern -->
  <div class="absolute inset-0 opacity-5 bg-dots-yellow pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Left: Content -->
        <div class="reveal-left">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Diseño en <span class="text-am-yellow">colaboración</span>
          </h2>
          <p class="text-lg text-gray-300 leading-relaxed mb-6">
            En Areamovil creemos en el diseño como un trabajo compartido.
            Nuestro equipo reúne distintas miradas para construir soluciones
            que equilibren funcionalidad, claridad, viabilidad y evolución.
          </p>
          <p class="text-base text-gray-400 leading-relaxed mb-8">
            Trabajamos de forma articulada entre diseño, producto y tecnología
            para convertir necesidades complejas en experiencias simples y bien pensadas.
          </p>
          <a href="/team" class="inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-am-accent
                   text-am-accent rounded-lg hover:bg-am-accent/10 transition-all duration-300 group text-lg font-semibold">
            Conoce al team
            <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Right: Visual -->
        <div class="relative reveal-right">
          <div class="relative p-12 rounded-2xl border border-white/10 bg-gradient-to-br from-white/5 to-transparent backdrop-blur-sm">

            <!-- Center icon -->
            <div class="flex justify-center mb-8">
              <div class="p-8 rounded-full bg-gradient-to-br from-am-yellow/20 to-am-yellow/5 border border-am-yellow/30">
                <svg class="w-16 h-16 text-am-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
            </div>

            <!-- Roles grid -->
            <div class="grid grid-cols-2 gap-4">
              {['UX Research', 'UI Design', 'Product Design', 'Design Systems'].map((role, i) => (
                <div class="p-4 rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm text-center
                            hover:border-am-accent/50 hover:shadow-lg hover:shadow-am-accent/10 transition-all duration-300
                            reveal-scale" data-delay={String(0.3 + i * 0.1)}>
                  <div class="text-sm font-medium text-white">{role}</div>
                </div>
              ))}
            </div>

            <!-- Connection lines -->
            <div class="absolute inset-0 pointer-events-none opacity-20">
              <svg class="w-full h-full" viewBox="0 0 400 400">
                <line x1="50" y1="50" x2="350" y2="350" stroke="#0A84FF" stroke-width="1" stroke-dasharray="5,5"/>
                <line x1="350" y1="50" x2="50" y2="350" stroke="#FFC501" stroke-width="1" stroke-dasharray="5,5"/>
              </svg>
            </div>
          </div>

          <!-- Floating accents -->
          <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full bg-am-accent/20 blur-2xl animate-pulse-glow pointer-events-none"></div>
          <div class="absolute -bottom-6 -left-6 w-32 h-32 rounded-full bg-am-yellow/20 blur-2xl animate-pulse-glow pointer-events-none" style="animation-delay:1s"></div>
        </div>
      </div>
    </div>
  </div>
</section>

---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-b from-am-dark to-am-blue">

  <!-- Grid Pattern -->
  <div class="absolute inset-0 opacity-10 bg-grid pointer-events-none"></div>

  <!-- Floating UI Elements -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Top-right box -->
    <div class="absolute top-20 right-20 w-64 h-64 border border-am-accent/30 rounded-lg backdrop-blur-sm hidden lg:block animate-float">
      <div class="absolute inset-0 bg-gradient-to-br from-am-accent/10 to-transparent rounded-lg"></div>
      <svg class="absolute top-4 right-4 w-8 h-8 text-am-accent/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
      </svg>
    </div>

    <!-- Bottom-left box -->
    <div class="absolute bottom-32 left-20 w-48 h-48 border border-am-yellow/30 rounded-lg backdrop-blur-sm hidden lg:block animate-float-rev">
      <div class="absolute inset-0 bg-gradient-to-br from-am-yellow/10 to-transparent rounded-lg"></div>
      <svg class="absolute bottom-4 left-4 w-8 h-8 text-am-yellow/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
      </svg>
    </div>

    <!-- Glow blob 1 -->
    <div class="absolute top-1/3 left-1/4 w-32 h-32 hidden md:block">
      <div class="w-full h-full rounded-full bg-am-accent/20 blur-3xl animate-pulse-glow"></div>
    </div>

    <!-- Cursor icon -->
    <div class="absolute bottom-1/4 right-1/3 hidden md:block animate-float-x">
      <svg class="w-12 h-12 text-am-yellow/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 4l7.07 17 2.51-7.39L21 11.07z"/>
      </svg>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container mx-auto px-6 py-24 relative z-10">
    <div class="max-w-4xl mx-auto text-center">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full border border-am-accent/30 bg-am-accent/5 backdrop-blur-sm reveal" data-delay="0">
        <span class="w-2 h-2 rounded-full bg-am-accent animate-pulse"></span>
        <span class="text-am-accent text-sm font-medium">Diseño UX/UI con visión de producto</span>
      </div>

      <!-- Title -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight reveal" data-delay="0.2">
        Diseñamos experiencias digitales que las personas
        <span class="text-am-accent"> entienden</span>,
        <span class="text-am-yellow"> usan</span> y
        <span class="bg-gradient-to-r from-am-accent to-am-yellow bg-clip-text text-transparent"> recuerdan</span>
      </h1>

      <!-- Supporting Text -->
      <p class="text-lg md:text-xl text-gray-300 mb-12 max-w-3xl mx-auto leading-relaxed reveal" data-delay="0.4">
        En Areamovil transformamos retos complejos en productos digitales
        claros, funcionales y visualmente sólidos. Combinamos investigación,
        estrategia y diseño para crear experiencias que conectan con las
        personas y aportan valor real al negocio.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center reveal" data-delay="0.6">
        <a href="/proyectos" class="btn-primary group">
          Ver proyectos
          <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/proceso" class="btn-secondary">
          Conocer nuestro proceso
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-am-dark to-transparent pointer-events-none"></div>
</section>

<style>
  .btn-primary {
    @apply inline-flex items-center bg-am-yellow text-am-dark font-semibold px-8 py-4 rounded-lg
           text-lg shadow-lg shadow-am-yellow/20 hover:bg-am-yellow/90 transition-all duration-300;
  }
  .btn-secondary {
    @apply inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-am-accent
           text-am-accent rounded-lg hover:bg-am-accent/10 transition-all duration-300 text-lg font-semibold;
  }
</style>

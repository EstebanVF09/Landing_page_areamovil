---
---
<section class="relative py-32 bg-gradient-to-b from-am-blue/20 to-am-dark overflow-hidden">
  <div class="absolute inset-0 opacity-5 bg-grid-lg pointer-events-none"></div>
  <div class="absolute top-20 left-20 w-96 h-96 bg-am-accent/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 right-20 w-96 h-96 bg-am-blue-mid/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Main card -->
    <div class="bg-gradient-to-br from-am-blue/30 to-am-dark/50 backdrop-blur-sm border border-am-accent/20 rounded-2xl p-12 md:p-16 text-center reveal
                hover:border-am-accent/40 transition-all duration-300">

      <div class="w-16 h-16 rounded-2xl bg-am-accent/10 border border-am-accent/30 flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-am-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </div>

      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 reveal" data-delay="0.1">
        Un proceso <span class="text-am-yellow">flexible</span>, pero nunca improvisado
      </h2>

      <p class="text-gray-300 text-lg leading-relaxed mb-12 max-w-3xl mx-auto reveal" data-delay="0.2">
        Adaptamos las herramientas y las etapas a cada contexto, pero siempre con un marco claro,
        criterio fundamentado y un objetivo compartido: construir productos digitales que funcionen
        mejor para las personas y para los negocios.
      </p>

      <!-- Stats row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12 reveal" data-delay="0.3">
        {[
          { value: '6', label: 'Etapas definidas',      color: '#0A84FF' },
          { value: '3+', label: 'Metodologías activas', color: '#014D94' },
          { value: '4',  label: 'Principios guía',      color: '#FFC501' },
          { value: '∞',  label: 'Iteraciones posibles', color: '#0A84FF' },
        ].map((stat) => (
          <div>
            <div class="text-4xl font-bold mb-1" style={`color:${stat.color}`}>{stat.value}</div>
            <div class="text-gray-400 text-sm">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center reveal" data-delay="0.4">
        <a href="/team" class="inline-flex items-center gap-2 bg-am-yellow text-am-dark hover:bg-am-yellow/90 font-semibold px-8 py-4 text-lg rounded-lg shadow-lg shadow-am-yellow/20 transition-all duration-300 group">
          Conoce al equipo
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/proyectos" class="inline-flex items-center gap-2 px-8 py-4 border border-am-accent/40 text-white rounded-lg hover:border-am-accent hover:bg-am-accent/10 transition-all duration-300 group">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Ver proyectos
        </a>
      </div>
    </div>
  </div>
</section>

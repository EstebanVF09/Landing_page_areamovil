---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-am-dark via-am-blue/10 to-am-dark"></div>
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-am-accent rounded-full blur-[120px] opacity-20 pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-am-blue-mid rounded-full blur-[120px] opacity-20 pointer-events-none"></div>
  <div class="absolute inset-0 opacity-[0.03] bg-grid pointer-events-none"></div>

  <!-- Wireframe decoratives -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/4 left-[10%] w-48 h-32 border border-am-accent/10 rounded-lg opacity-100"></div>
    <div class="absolute top-1/3 right-[15%] w-40 h-40 border border-am-yellow/10 rounded-lg"></div>
    <div class="absolute bottom-1/4 right-[10%] w-56 h-36 border border-am-accent/10 rounded-lg"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">

      <!-- Left: Content -->
      <div class="text-center lg:text-left">
        <div class="mb-6 reveal">
          <span class="inline-block px-4 py-2 rounded-full bg-am-accent/10 border border-am-accent/20 text-am-accent text-sm font-medium">
            Confianza de líderes de la industria
          </span>
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight reveal" data-delay="0.1">
          Experiencias digitales que respaldan
          <span class="text-am-accent"> empresas líderes</span> en Colombia y Latinoamérica
        </h1>

        <p class="text-lg text-gray-300 mb-12 leading-relaxed reveal" data-delay="0.2">
          Desde instituciones financieras hasta retail y sector público, hemos diseñado soluciones UX/UI
          para organizaciones que transforman industrias y mejoran la vida de millones de usuarios.
        </p>

        <div class="reveal" data-delay="0.3">
          <a href="#indice-proyectos"
            class="inline-flex items-center bg-am-yellow text-am-dark font-semibold px-8 py-4 rounded-lg
                   text-lg shadow-lg shadow-am-yellow/20 hover:bg-am-yellow/90 transition-all duration-300 group">
            Explorar casos
            <svg class="ml-2 w-5 h-5 group-hover:translate-y-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Client logos image -->
      <div class="relative hidden lg:block reveal-right" data-delay="0.4">
        <div class="absolute inset-0 bg-gradient-to-r from-am-accent/20 to-am-yellow/20 blur-3xl -z-10 rounded-2xl"></div>

        <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-white/5 to-transparent backdrop-blur-sm p-4">
          <div class="absolute top-0 right-0 w-20 h-20 border-t-2 border-r-2 border-am-accent/40 rounded-tr-2xl"></div>
          <div class="absolute bottom-0 left-0 w-20 h-20 border-b-2 border-l-2 border-am-yellow/40 rounded-bl-2xl"></div>
          <div class="relative rounded-xl overflow-hidden">
            <img
              src="/assets/a92acfbff7a81e9821e6d755039de0c05c899fb0.png"
              alt="Clientes: Bancolombia, Avianca, Sura, Isagen, Mapfre y más"
              class="w-full h-auto"
              loading="eager"
            />
          </div>
        </div>

        <!-- Floating decoration -->
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-am-yellow/10 border border-am-yellow/30 rounded-2xl backdrop-blur-sm animate-float"></div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-y">
    <div class="w-6 h-10 border-2 border-white/20 rounded-full flex items-start justify-center p-2">
      <div class="w-1 h-2 bg-white/40 rounded-full"></div>
    </div>
  </div>
</section>

---
const bloques = [
  {
    title: 'Estrategia que alinea',
    description: 'Definimos prioridades, tiempos y objetivos para que cada proyecto avance con dirección clara.',
    color: '#0A84FF',
    icon: 'target',
  },
  {
    title: 'Diseño que interpreta',
    description: 'Traducimos necesidades, hallazgos y oportunidades en recorridos, estructuras e interfaces comprensibles.',
    color: '#FFC501',
    icon: 'layers',
  },
  {
    title: 'Colaboración que conecta',
    description: 'Trabajamos de forma articulada entre perfiles y con otros equipos para asegurar soluciones viables, coherentes y bien implementadas.',
    color: '#014D94',
    icon: 'users',
  },
];
---

<section class="relative py-32 bg-gradient-to-b from-am-dark to-am-blue/20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 reveal">
        Así entendemos el <span class="text-am-yellow">trabajo en equipo</span>
      </h2>
      <p class="text-gray-300 text-lg leading-relaxed reveal" data-delay="0.1">
        Nuestro proceso no depende de una sola disciplina. Diseñamos mejor cuando combinamos organización,
        visión de producto, comprensión del usuario y sensibilidad visual en una misma conversación.
      </p>
    </div>

    <!-- Connection line -->
    <div class="hidden lg:block relative h-[2px] mb-0" style="top: calc(50% + 10rem)">
      <div class="h-full bg-gradient-to-r from-transparent via-am-accent/30 to-transparent"></div>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      {bloques.map((b, i) => (
        <div class="relative group reveal" data-delay={String(0.2 + i * 0.15)}>

          <!-- Connection node (desktop) -->
          <div class="hidden lg:block absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
            <div class="w-4 h-4 rounded-full animate-pulse-dot" style={`background:${b.color};box-shadow:0 0 20px ${b.color}80`}></div>
          </div>

          <div class="bg-am-dark border border-am-accent/20 rounded-2xl p-8 h-full
                      hover:border-am-accent/40 transition-all duration-300
                      hover:shadow-[0_0_30px_rgba(10,132,255,0.1)]">

            <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
              style={`background:${b.color}20;border:1px solid ${b.color}40`}>
              {b.icon === 'target' && (
                <svg class="w-7 h-7" style={`color:${b.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              )}
              {b.icon === 'layers' && (
                <svg class="w-7 h-7" style={`color:${b.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              )}
              {b.icon === 'users' && (
                <svg class="w-7 h-7" style={`color:${b.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              )}
            </div>

            <h3 class="text-white text-xl font-semibold mb-4">{b.title}</h3>
            <p class="text-gray-400 leading-relaxed">{b.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

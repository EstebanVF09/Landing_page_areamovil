---
---
<footer class="bg-am-dark border-t border-white/10">
  <div class="container mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">

      <!-- Brand -->
      <div class="lg:col-span-2 reveal">
        <img
          src="/assets/51b9d4cc2d7f97a1f13cce2d0e93663c9bc9d047.png"
          alt="Areamovil"
          class="h-10 w-auto mb-4"
        />
        <p class="text-gray-400 leading-relaxed max-w-md">
          Diseñamos experiencias digitales con criterio, equilibrando
          investigación, estrategia y usabilidad para crear productos que
          aportan valor real.
        </p>

        <!-- Social Links -->
        <div class="flex gap-4 mt-6">
          <a href="#" aria-label="Email" class="footer-social">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/>
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="footer-social">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="footer-social">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav -->
      <div class="reveal" data-delay="0.3">
        <h3 class="text-white font-semibold mb-4 text-lg">Navegación</h3>
        <ul class="space-y-3">
          <li><a href="/"          class="footer-link">Home</a></li>
          <li><a href="/proceso"   class="footer-link">Proceso</a></li>
          <li><a href="/proyectos" class="footer-link">Proyectos</a></li>
          <li><a href="/team"      class="footer-link">Team</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="reveal" data-delay="0.4">
        <h3 class="text-white font-semibold mb-4 text-lg">Contacto</h3>
        <ul class="space-y-3">
          <li>
            <a href="mailto:contactenos@areamovil.com.co" class="text-gray-400 hover:text-am-yellow transition-colors">
              contactenos@areamovil.com.co
            </a>
          </li>
          <li class="text-gray-400">Colombia</li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 reveal" data-delay="0.5">
      <p class="text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} Areamovil. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-gray-500 hover:text-am-accent text-sm transition-colors">Política de privacidad</a>
        <a href="#" class="text-gray-500 hover:text-am-accent text-sm transition-colors">Términos de uso</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    @apply p-3 rounded-lg border border-white/10 bg-white/5 text-gray-400
           hover:border-am-accent hover:bg-am-accent/10 hover:text-am-accent
           transition-all duration-300;
  }
  .footer-link {
    @apply text-gray-400 hover:text-am-accent transition-colors;
  }
</style>
